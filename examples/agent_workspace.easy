#!/usr/bin/env easy
# An OpenCode-style static workspace built with Easy Lang primitives.

clear
say "EASY AGENT  •  main  •  ollama / llama3.2" [header] :cyan:
row "SESSIONS" | "workspace / easy-lang" [left:28]
row "› Build editor\n  Refactor parser\n  API playground" | "You\nMake the completion popup work like VS Code." [left:28]
row "FILES\n  easy_lang/editor.py\n  easy_lang/interpreter.py\n  tests/smoke_test.py" | "Easy\nI updated Tab to accept the highlighted suggestion." [left:28]
row "STATUS\n  ● Connected\n  2 files changed" | "TOOL\n✓ python3 tests/smoke_test.py\n  smoke test passed" [left:28]
say "Type a prompt…                         / commands   Enter send" [footer] :magenta:
